        },
        {
          "type": "text",
          "id": "spec_label",
          "label": "Specialisations label",
          "default": "Specialisations"
        },
        {
          "type": "text",
          "id": "spec_text",
          "label": "Specialisations text",
          "default": "Medication safety, clinical governance, audit and service improvement."
